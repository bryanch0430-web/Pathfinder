          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "section",
        "kind",
        "message"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "DataQuality": {
      "properties": {
        "sources_used": {
          "items": {
            "type": "string"
          },
          "title": "Sources Used",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/DataGap"
          },
          "title": "Gaps",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "search_window_months": {
          "default": 24,
          "title": "Search Window Months",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "freshness": {
          "items": {
            "$ref": "#/$defs/FreshnessMark"
          },
          "title": "Freshness",
          "type": "array"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "DataStatus": {
      "enum": [
        "ok",
        "stale",
        "unavailable"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "DateRange": {
      "properties": {
