      },
      "required": [
        "name",
        "check_in",
        "check_out"
      ],
      "title": "HotelStay",
      "type": "object"
    },
    "ItemType": {
      "enum": [
        "attraction",
        "hotel",
        "meal",
        "transit",
        "ticket"
      ],
      "title": "ItemType",
      "type": "string"
    },
    "Money": {
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
