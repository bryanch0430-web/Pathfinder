{
  "$defs": {
    "AssessmentSignal": {
      "description": "One thing that lowered the plan's confidence, and by how much (0 to 1).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "weight",
        "message"
      ],
      "title": "AssessmentSignal",
      "type": "object"
    },
    "ConstraintCheck": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConstraintStatus",
          "default": "unknown"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ConstraintCheck",
      "type": "object"
    },
    "ConstraintStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "title": "ConstraintStatus",
      "type": "string"
    },
    "CostBreakdown": {
      "properties": {
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CostLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "total": {
          "default": 0.0,
          "title": "Total",
          "type": "number"
        },
        "budget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "remaining": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "within",
            "over",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "CostBreakdown",
      "type": "object"
    },
    "CostLine": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "kind": {
          "default": "estimate",
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "label",
        "amount"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "DataGap": {
