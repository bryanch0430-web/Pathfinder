        "timezone": {
          "default": "",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Destination",
      "type": "object"
    },
    "Disruption": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "affected_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Item Ids",
          "type": "array"
        },
        "resolution": {
          "default": "",
          "title": "Resolution",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "Disruption",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "no_data",
        "timeout",
        "rate_limit",
        "server_error",
        "invalid_request",
        "auth",
        "blocked",
        "network",
        "parse"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "FreshnessMark": {
      "description": "A time-sensitive section checked against its freshness window (Proposal DB-13).\n\n``outdated``: older than the window and not yet re-fetched. ``refreshed``: its\nown agent fetched it again at ``checked_at``; ``fetched_at`` is the old stamp.",
      "properties": {
        "section": {
          "enum": [
            "weather",
            "tickets",
            "hotels"
          ],
          "title": "Section",
          "type": "string"
        },
        "status": {
          "enum": [
            "outdated",
            "refreshed"
          ],
          "title": "Status",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "window_seconds": {
          "title": "Window Seconds",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "section",
        "status",
        "fetched_at",
        "checked_at",
        "window_seconds"
      ],
      "title": "FreshnessMark",
      "type": "object"
    },
    "GeoPoint": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "HotelNearby": {
      "description": "A way to reach a place near the hotel, exactly as the hotel source listed it (\"Taxi\", \"11 min\").",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "",
          "title": "Type",
          "type": "string"
        },
        "duration": {
          "default": "",
          "title": "Duration",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HotelNearby",
      "type": "object"
    },
    "HotelStay": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "area": {
          "default": "",
          "title": "Area",
          "type": "string"
        },
        "geo": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "price_per_night": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price_kind": {
          "$ref": "#/$defs/PriceKind",
          "default": "none"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "review_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
