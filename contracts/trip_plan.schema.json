    "PlanAlternative": {
      "description": "Another real choice for a stop, with the same source facts as the stop itself.\n\nEvery field comes from a place source except ``distance_m``, which the app computes\n(straight line from the default stop). A fact the source did not give stays empty.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "geo": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "address": {
          "default": "",
          "title": "Address",
          "type": "string"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "review_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Count"
        },
        "price_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Level"
        },
        "cuisine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuisine"
        },
        "reservable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservable"
        },
        "opening_hours": {
          "items": {
            "type": "string"
          },
          "title": "Opening Hours",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "booking_url": {
          "default": "",
          "title": "Booking Url",
          "type": "string"
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "title": "Source Types",
          "type": "array"
        },
        "source_summary": {
          "default": "",
          "title": "Source Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "PlanAlternative",
      "type": "object"
    },
    "PlanAssessment": {
      "description": "How far the plan can be relied on, worked out by the app from the plan's own checks.\n\n``confidence`` is 1 less the signals' weights, never a model's opinion. ``unverified`` lists\nwhat no source confirmed; ``missing`` what only the traveller can say. ``next_action`` is what\nthe planner does about it: ``research`` (look again, then assess again), ``ask`` (put\n``question`` to the traveller) or ``none``.",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "level": {
          "default": "high",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Level",
          "type": "string"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/AssessmentSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "unverified": {
          "items": {
            "type": "string"
          },
          "title": "Unverified",
          "type": "array"
        },
        "next_action": {
          "default": "none",
          "enum": [
            "none",
            "research",
            "ask"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "question": {
          "default": "",
          "title": "Question",
          "type": "string"
        },
        "research_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Research Rounds",
          "type": "integer"
        },
        "improvements": {
          "items": {
            "type": "string"
          },
          "title": "Improvements",
          "type": "array"
        }
      },
      "title": "PlanAssessment",
      "type": "object"
    },
