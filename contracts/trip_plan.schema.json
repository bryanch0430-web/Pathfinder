          "title": "Distance To Centre Km"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "data_status": {
          "$ref": "#/$defs/DataStatus",
          "default": "ok"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "booking_url": {
          "default": "",
          "title": "Booking Url",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "amenities": {
          "items": {
            "type": "string"
          },
          "title": "Amenities",
          "type": "array"
        },
        "hotel_class": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hotel Class"
        },
        "property_token": {
          "default": "",
          "title": "Property Token",
          "type": "string"
        },
        "nearby": {
          "items": {
            "$ref": "#/$defs/HotelNearby"
          },
          "title": "Nearby",
          "type": "array"
        },
        "room_types": {
          "items": {
            "$ref": "#/$defs/RoomType"
          },
          "title": "Room Types",
          "type": "array"
        },
        "rooms_checked_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nearest_stop_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearest Stop Km"
        },
        "nearest_stop_name": {
