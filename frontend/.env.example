# Base URL of the Pathfinder API. Leave empty to use the same origin as the page
# (the Vite dev server proxies /api to the backend, see vite.config.ts).
# Example for a separately hosted backend: VITE_API_BASE=http://localhost:8000
VITE_API_BASE=

# Dev server only: where the /api proxy points. Default http://127.0.0.1:8000
# (not "localhost": on Node 18 that resolves to ::1 first, but uvicorn binds 127.0.0.1).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
