APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./pathfinder.db
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
LANGSMITH_TRACING=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FAST_MODEL=deepseek-flash
# Optional destination research API; existing HTML search is used without this key.
TAVILY_API_KEY=

# System 1 router. Leave the URL and key empty to use the rules, then the writer model.
# Jev is TypeSafe's decision model: POST {url}/v1/systemone with a choice question.
DECISION_ENABLED=false
DECISION_API_URL=
DECISION_API_KEY=
DECISION_MODEL=jev-latest
DECISION_PATH=/v1/systemone
DECISION_TIMEOUT_SECONDS=8
ROUTER_THRESHOLD=0.8
ROUTER_RULES_FIRST=true
# false: chat follows the original planner. true: rules, then Jev, then the writer, then the gate.
ROUTER_ENABLED=false

# Optional hotel and flight references (SerpApi). The planner never books.
SERPAPI_KEY=
SERPAPI_KEY_POOL=
ENABLE_HOTELS=true
ENABLE_FLIGHTS=true
ENABLE_ROUTES=false
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_ENABLED=false
YOUTUBE_API_KEY=
