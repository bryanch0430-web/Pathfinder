ing">Include Fushimi Inari Taisha</Data></Cell><Cell><Data ss:Type="String">remove_fushimi</Data></Cell><Cell><Data ss:Type="String">fail</Data></Cell><Cell><Data ss:Type="String">pass</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="String">True</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="Number">3307.0</Data></Cell></Row><Row><Cell><Data ss:Type="String">flash</Data></Cell><Cell><Data ss:Type="String">v17</Data></Cell><Cell><Data ss:Type="String">Every stay must be confirmed by a source</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">pass</Data></Cell><Cell><Data ss:Type="String">pass</Data></Cell><Cell><Data ss:Type="String">True</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="Number">3462.6</Data></Cell></Row><Row><Cell><Data ss:Type="String">flash</Data></Cell><Cell><Data ss:Type="String">v18</Data></Cell><Cell><Data ss:Type="String">Every stay must be confirmed by a source</Data></Cell><Cell><Data ss:Type="String">unsourced_hotel</Data></Cell><Cell><Data ss:Type="String">fail</Data></Cell><Cell><Data ss:Type="String">fail</Data></Cell><Cell><Data ss:Type="String">True</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="Number">3538.2</Data></Cell></Row><Row><Cell><Data ss:Type="String">flash</Data></Cell><Cell><Data ss:Type="String">v19</Data></Cell><Cell><Data ss:Type="String">All days must fall inside the trip dates</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">pass</Data></Cell><Cell><Data ss:Type="String">pass</Data></Cell><Cell><Data ss:Type="String">True</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="String">False</Data></Cell><Cell><Data ss:Type="Number">3369.5</Data></Cell></Row><Row><Cell><Data ss:Type="Stri