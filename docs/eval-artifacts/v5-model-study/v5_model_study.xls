<?xml version="1.0" encoding="UTF-8"?><?mso-application progid="Excel.Sheet"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Styles><Style ss:ID="header"><Font ss:Bold="1"/><Interior ss:Color="#E8F3F5" ss:Pattern="Solid"/></Style></Styles><Worksheet ss:Name="README"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">v5 part-model study</Data></Cell></Row><Row><Cell><Data ss:Type="String">Generated</Data></Cell><Cell><Data ss:Type="String">2026-11-23T03:17:54</Data></Cell></Row><Row><Cell><Data ss:Type="String">Code</Data></Cell><Cell><Data ss:Type="String">Pathfinder v5 backend; commit 08361dd + study harness</Data></Cell></Row><Row><Cell><Data ss:Type="String">Provider</Data></Cell><Cell><Data ss:Type="String">Poe OpenAI-compatible endpoint</Data></Cell></Row><Row><Cell><Data ss:Type="String">Sandbox</Data></Cell><Cell><Data ss:Type="String">PATHFINDER_SANDBOX=1</Data></Cell></Row><Row><Cell><Data ss:Type="String">Protocol</Data></Cell><Cell><Data ss:Type="String">One run per arm; same frozen cases; missing/error = wrong; Wilson 95%; exact McNemar for routing.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Results</Data></Cell><Cell><Data ss:Type="String">RESULTS.md / PART_MODEL_DECISIONS.md / TRACE_INDEX.md</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Protocol"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Item</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Value</Data></Cell></Row><Row><Cell><Data ss:Type="String">Models</Data></Cell><Cell><Data ss:Type="String">claude-sonnet-5.5; gemini-3.5-flash-lite; deepseek-v4-flash; jev-latest</Data></Cell></Row><Row><Cell><Data ss:Type="String">Unavailable</Data></Cell><Cell><Data ss:Type="String">gpt-5-nano/mini (Poe 400); gemini-3.8-flash (empty); deepseek routing (timeout at c=4)</Data></Cell></Row><Row><Cell><Data ss:Type="String">Routing</Data></Cell><Cell><Data ss:Type="String">84 frozen utterances; 21 each plan/modify/ask/unclear</Data></Cell></Row><Row><Cell><Data ss:Type="String">Planner</Data></Cell><Cell><Data ss:Type="String">Hong Kong 8 + Japan 6</Data></Cell></Row><Row><Cell><Data ss:Type="String">Editor</Data></Cell><Cell><Data ss:Type="String">4 frozen plans: remove, move, time, remove</Data></Cell></Row><Row><Cell><Data ss:Type="String">Verifier</Data></Cell><Cell><Data ss:Type="String">10 plans: 5 good + 5 injected defects</Data></Cell></Row><Row><Cell><Data ss:Type="String">Ask</Data></Cell><Cell><Data ss:Type="String">12 questions; q11 is a separate scope case</Data></Cell></Row><Row><Cell><Data ss:Type="String">Memory</Data></Cell><Cell><Data ss:Type="String">8 synthetic traveller histories</Data></Cell></Row><Row><Cell><Data ss:Type="String">Statistics</Data></Cell><Cell><Data ss:Type="String">Wilson 95%; exact McNemar for routing; descriptive for small-n parts</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Recommendations"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">part</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">choice</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">temperature</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">cap</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">reasoning</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">threshold</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">evidence</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">tradeoff</Data></Cell></Row><Row><Cell><Data ss:Type="String">Analyst / understanding</Data></Cell><Cell><Data ss:Type="String">Gemini 3.5 Flash-Lite</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">4,096</Data></Cell><Cell><Data ss:Type="String">none (not supported by these Poe models)</Data></Cell><Cell><Data ss:Type="String">0.8 (0.9 when false routes are costlier)</Data></Cell><Cell><Data ss:Type="String">83/84 = 98.8% (Wilson 93.6–99.8), p50 4.1 s, 2.9k tokens; Sonnet 98.8% / 6.3 s / 4.6k. Sonnet 0 vs 0.2: identical 83/84.</Data></Cell><Cell><Data ss:Type="String">Flash-Lite ties the best accuracy and is faster/cheaper; Sonnet has no accuracy gain here. DeepSeek V4.1 Flash also scored 98.8% but was the slowest (8.5 s).</Data></Cell></Row><Row><Cell><Data ss:Type="String">Turn router</Data></Cell><Cell><Data ss:Type="String">LLM router (Flash-Lite) default; Jev as optional fast pre-gate</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">4,096</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">0.8 for the LLM; 0.8 for a Jev pre-gate</Data></Cell><Cell><Data ss:Type="String">Jev alone 79/84 = 94.0%, p50 0.6 s; at 0.8 it keeps 66% at 100% and escalates 29. Jev→Flash fallback: 84/84 = 100%, ~2.0 s mean. Jev→Sonnet: 83/84, ~3.3 s.</Data></Cell><Cell><Data ss:Type="String">Pure Jev is fastest but weaker on modify/ask. The hybrid is best but adds a second call path; it is not a shipped setting yet.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Planner</Data></Cell><Cell><Data ss:Type="String">Gemini 3.5 Flash-Lite</Data></Cell><Cell><Data ss:Type="String">0.2 (production setting; not swept)</Data></Cell><Cell><Data ss:Type="String">12,000</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">14/17 each (82.4%). Hong Kong constraints 85.7% vs 68.8%; Japan 6/6 both; TravelPlanner 2/3 vs 3/3. Flash 323 s total vs Sonnet 920 s.</Data></Cell><Cell><Data ss:Type="String">Small n (17) and one run. Flash ties overall and is much faster; Sonnet is stronger on TravelPlanner-style constraints. Keep the 12k cap: planner JSON needs it.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Editor</Data></Cell><Cell><Data ss:Type="String">Gemini 3.5 Flash-Lite</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">2,000</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">8/8 for all three; p50 3.4 s (Flash) vs 5.6 s (Sonnet) and 6.6 s (DeepSeek); mean tokens 3.4k vs 11.6k (Sonnet) and 3.1k (DeepSeek).</Data></Cell><Cell><Data ss:Type="String">All three pass the 8-case set; Flash is fastest, DeepSeek has the fewest tokens but is slower. Flash wins on the pre-declared latency tie-break.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Verifier</Data></Cell><Cell><Data ss:Type="String">DeepSeek V4 Flash</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">1,500</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">18/20, 2 false passes, p50 4.0 s; Sonnet 18/20, 2 false passes, 5.7 s; Flash 17/20, 3 false passes, 3.4 s.</Data></Cell><Cell><Data ss:Type="String">All models missed transfer arithmetic (v06/v14); this is a verifier coverage gap, not only a model choice. DeepSeek matches Sonnet with lower latency. Use code checks for arithmetic/transfers.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Ask / quick answers</Data></Cell><Cell><Data ss:Type="String">DeepSeek V4 Flash</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">1,400</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">11/11 in-scope (100%), p50 16.1 s; Sonnet 11/11 / 20.2 s; Flash 10/11 / 14.4 s. Off-topic q11 was a scope case for all three and is excluded.</Data></Cell><Cell><Data ss:Type="String">DeepSeek matches Sonnet with lower latency. Ask calls are slow (15–20 s) because the path re-reads the plan; that is a separate latency issue.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Memory</Data></Cell><Cell><Data ss:Type="String">DeepSeek V4 Flash with a no-invention check; Sonnet if precision is the priority</Data></Cell><Cell><Data ss:Type="String">0</Data></Cell><Cell><Data ss:Type="String">700</Data></Cell><Cell><Data ss:Type="String">none</Data></Cell><Cell><Data ss:Type="String">—</Data></Cell><Cell><Data ss:Type="String">DeepSeek recall 91.7% vs Sonnet/Flash 79.8%; but DeepSeek invented preferences on the one 'nothing to remember' case (m06). Sonnet/Flash did not.</Data></Cell><Cell><Data ss:Type="String">Best recall vs one false memory in 8 cases. A write-time validation (must be supported by the message/plan) is required before using DeepSeek.</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Cases"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">part</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">id</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">input</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">gold</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">check</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r01</Data></Cell><Cell><Data ss:Type="String">Plan a 5-day trip to Kyoto for 2 people in April, budget 4000 USD</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r02</Data></Cell><Cell><Data ss:Type="String">I want to visit Tokyo for a week with my partner</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r03</Data></Cell><Cell><Data ss:Type="String">Can you build an itinerary for Hong Kong, 3 days, 2 travellers?</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r04</Data></Cell><Cell><Data ss:Type="String">What is the weather in Kyoto on 12 April?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r05</Data></Cell><Cell><Data ss:Type="String">Which hotel did you pick and why?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r06</Data></Cell><Cell><Data ss:Type="String">How much is the flight?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r07</Data></Cell><Cell><Data ss:Type="String">Swap the hotel for something boutique</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r08</Data></Cell><Cell><Data ss:Type="String">Move day 2 to the afternoon and keep the rest</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r09</Data></Cell><Cell><Data ss:Type="String">Make the budget 3000 USD instead</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r10</Data></Cell><Cell><Data ss:Type="String">Add a museum on the last day</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r11</Data></Cell><Cell><Data ss:Type="String">Hmm</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r12</Data></Cell><Cell><Data ss:Type="String">What about it?</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r13</Data></Cell><Cell><Data ss:Type="String">Plan something nice</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r14</Data></Cell><Cell><Data ss:Type="String">I am going to Osaka next month with three friends for four days and want a plan under 200000 JPY</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r15</Data></Cell><Cell><Data ss:Type="String">Replace the second day's temple with a park</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r16</Data></Cell><Cell><Data ss:Type="String">Is the hotel near the train station?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r17</Data></Cell><Cell><Data ss:Type="String">What time does the flight leave?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r18</Data></Cell><Cell><Data ss:Type="String">Change the dates to the first week of May</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r19</Data></Cell><Cell><Data ss:Type="String">Surprise me</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r20</Data></Cell><Cell><Data ss:Type="String">Help</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r21</Data></Cell><Cell><Data ss:Type="String">Plan a new trip: 4 days in Osaka for a family of four in July</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r22</Data></Cell><Cell><Data ss:Type="String">Start over - I'd like a fresh itinerary for Tokyo, 6 nights, solo, mid-range hotels</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r23</Data></Cell><Cell><Data ss:Type="String">We're thinking of a long weekend in Hong Kong, flying from Singapore, two adults</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r24</Data></Cell><Cell><Data ss:Type="String">Organise a 3-day food trip to Osaka for me and my sister in November</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r25</Data></Cell><Cell><Data ss:Type="String">Create a different itinerary for Kyoto in cherry blossom season, 5 days, budget 300000 JPY</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r26</Data></Cell><Cell><Data ss:Type="String">Book us a honeymoon in Kyoto, 7 nights, ryokan stays, no budget limit</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r27</Data></Cell><Cell><Data ss:Type="String">I need a business trip itinerary for Tokyo, Monday to Thursday, near Shinjuku</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r28</Data></Cell><Cell><Data ss:Type="String">New trip please: Tokyo to Hong Kong for 5 days over Christmas, 2 adults and a toddler</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r29</Data></Cell><Cell><Data ss:Type="String">Help me plan two days in Hong Kong for a school group of 10 students</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r30</Data></Cell><Cell><Data ss:Type="String">Make a plan for Osaka and Nara, 4 days, leaving from Hong Kong on 3 March</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r31</Data></Cell><Cell><Data ss:Type="String">I'd love to see Tokyo in autumn - 5 days, two people, around 3000 USD in total</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r32</Data></Cell><Cell><Data ss:Type="String">Let's plan another trip, this time to Kyoto for three nights with my parents</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r33</Data></Cell><Cell><Data ss:Type="String">Can you put together a 4-day Hong Kong itinerary for a couple on a tight budget?</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r34</Data></Cell><Cell><Data ss:Type="String">Plan me a weekend in Osaka</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r35</Data></Cell><Cell><Data ss:Type="String">Going to Tokyo for 10 days in spring with my wife, we love art and ramen</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r36</Data></Cell><Cell><Data ss:Type="String">Arrange a 3-day Kyoto trip for a wheelchair user and a carer, step-free where possible</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r37</Data></Cell><Cell><Data ss:Type="String">Drop the teamLab visit, we've been already</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r38</Data></Cell><Cell><Data ss:Type="String">Can you swap day 1 and day 3?</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r39</Data></Cell><Cell><Data ss:Type="String">Upgrade the hotel to something with a view of the harbour</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r40</Data></Cell><Cell><Data ss:Type="String">Remove Fushimi Inari, my knees won't handle the climb</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r41</Data></Cell><Cell><Data ss:Type="String">Shorten the trip to 3 days and keep the best stops</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r42</Data></Cell><Cell><Data ss:Type="String">Add a dim sum lunch on day 2</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r43</Data></Cell><Cell><Data ss:Type="String">Switch the flight to an evening departure</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r44</Data></Cell><Cell><Data ss:Type="String">I'd rather not walk so much on the second day</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r45</Data></Cell><Cell><Data ss:Type="String">That hotel is too expensive, find one under 150 USD a night</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r46</Data></Cell><Cell><Data ss:Type="String">Put a rest afternoon after the Peak hike</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r47</Data></Cell><Cell><Data ss:Type="String">Extend the stay by one night</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r48</Data></Cell><Cell><Data ss:Type="String">Make it a slower pace with fewer temples</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r49</Data></Cell><Cell><Data ss:Type="String">Cancel the day trip to Nara and stay in Osaka instead</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r50</Data></Cell><Cell><Data ss:Type="String">What if we did Lantau on day 3 instead of day 1?</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r51</Data></Cell><Cell><Data ss:Type="String">How far is Kiyomizu-dera from the hotel?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r52</Data></Cell><Cell><Data ss:Type="String">Is Senso-ji open early in the morning?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r53</Data></Cell><Cell><Data ss:Type="String">What's the total cost so far?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r54</Data></Cell><Cell><Data ss:Type="String">Do I need to book the Peak Tram in advance?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r55</Data></Cell><Cell><Data ss:Type="String">Will it rain on day 3</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r56</Data></Cell><Cell><Data ss:Type="String">Tell me more about Dotonbori</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r57</Data></Cell><Cell><Data ss:Type="String">how long is the walk between the two temples on day 2</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r58</Data></Cell><Cell><Data ss:Type="String">Which day has the most walking?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r59</Data></Cell><Cell><Data ss:Type="String">Is the Star Ferry included in the budget?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r60</Data></Cell><Cell><Data ss:Type="String">Can I pay with an Octopus card at the night market?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r61</Data></Cell><Cell><Data ss:Type="String">Why did you put Osaka Castle on the first morning?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r62</Data></Cell><Cell><Data ss:Type="String">Are there vegetarian options near Gion?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r63</Data></Cell><Cell><Data ss:Type="String">Remind me what we're doing on the last evening</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r64</Data></Cell><Cell><Data ss:Type="String">What's the best way to get from the airport to the hotel?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r65</Data></Cell><Cell><Data ss:Type="String">Should we bring umbrellas for the trip?</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r66</Data></Cell><Cell><Data ss:Type="String">ok</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r67</Data></Cell><Cell><Data ss:Type="String">asdfgh</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r68</Data></Cell><Cell><Data ss:Type="String">Not sure yet, maybe somewhere warm?</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r69</Data></Cell><Cell><Data ss:Type="String">I don't know</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r70</Data></Cell><Cell><Data ss:Type="String">The thing we talked about</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r71</Data></Cell><Cell><Data ss:Type="String">Do it</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r72</Data></Cell><Cell><Data ss:Type="String">yes</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r73</Data></Cell><Cell><Data ss:Type="String">What's the capital of Australia?</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r74</Data></Cell><Cell><Data ss:Type="String">Write me a poem about the sea</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r75</Data></Cell><Cell><Data ss:Type="String">Somewhere</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r76</Data></Cell><Cell><Data ss:Type="String">Can you?</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r77</Data></Cell><Cell><Data ss:Type="String">Same as last time</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r78</Data></Cell><Cell><Data ss:Type="String">Next</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r79</Data></Cell><Cell><Data ss:Type="String">Never mind</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r80</Data></Cell><Cell><Data ss:Type="String">Thoughts?</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r81</Data></Cell><Cell><Data ss:Type="String">幫我規劃一個五日四夜的京都行程，兩個人，預算三十萬日圓</Data></Cell><Cell><Data ss:Type="String">plan</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r82</Data></Cell><Cell><Data ss:Type="String">把酒店換成近新宿站的</Data></Cell><Cell><Data ss:Type="String">modify</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r83</Data></Cell><Cell><Data ss:Type="String">天星小輪最後一班幾點開？</Data></Cell><Cell><Data ss:Type="String">ask</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">analyst</Data></Cell><Cell><Data ss:Type="String">r84</Data></Cell><Cell><Data ss:Type="String">唔知呀</Data></Cell><Cell><Data ss:Type="String">unclear</Data></Cell><Cell><Data ss:Type="String">intent equality</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk01</Data></Cell><Cell><Data ss:Type="String">A three-day Hong Kong trip based in Mong Kok. Day 1 covers Central's heritage, the Peak at dusk and the harbour at night. Day 2, the typhoon day, stays entirely indoors with the two West Kowloon museu</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk02</Data></Cell><Cell><Data ss:Type="String">Two balanced days that split Hong Kong between Central heritage and the Kowloon side. Day 1 covers Tai Kwun, a Star Ferry crossing, the Palace Museum and the harbour light show. Day 2 covers Wong Tai </Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk03</Data></Cell><Cell><Data ss:Type="String">A balanced three-day Hong Kong trip. Day 1 stays in Kowloon on foot, by taxi and by ferry, because of the MTR delays. Day 2 covers Central and the Peak. Day 3 is a museum day in West Kowloon with a Ce</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk04</Data></Cell><Cell><Data ss:Type="String">A balanced two-day city break from Shenzhen. Day 1 covers Central's heritage sites and Victoria Peak at dusk. Day 2 starts at the Palace Museum, then takes in Wong Tai Sin Temple, a Star Ferry crossin</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk05</Data></Cell><Cell><Data ss:Type="String">Two days that show Hong Kong from both sides of the harbour. Day 1 covers Hong Kong Island: temples, heritage and the Peak at sunset. Day 2 is in Kowloon: the Palace Museum, a Taoist temple and the ha</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk06</Data></Cell><Cell><Data ss:Type="String">Two days in Hong Kong for six. Day 1 stays in Kowloon in short hops around Tsim Sha Tsui, with a museum, an early dim sum dinner, Temple Street Night Market and the harbour light show. Day 2 is built </Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk07</Data></Cell><Cell><Data ss:Type="String">A two-day Hong Kong sampler that puts the Palace Museum on Monday and M+ on Tuesday, because each is closed on the other day. Day 1 covers the harbour and the Peak at sunset. Day 2 covers West Kowloon</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">hk08</Data></Cell><Cell><Data ss:Type="String">A two-day Hong Kong trip that stays indoors on the typhoon day, with two West Kowloon museums and cheap local food. The second day covers Central heritage, the Peak and a harbour crossing with the eve</Data></Cell><Cell><Data ss:Type="String">hongkong: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp01</Data></Cell><Cell><Data ss:Type="String">A four-day Kyoto trip with a balanced pace. It opens with a relaxed arrival day at Nijo Castle and Gion. Day 2 has Fushimi Inari first thing, then the Higashiyama temples. Day 3 covers Arashiyama and </Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp02</Data></Cell><Cell><Data ss:Type="String">Five days in Tokyo that mix the big sights with quieter stops: Asakusa and Skytree on arrival, then shrines, gardens and museums, a Toyosu and Odaiba day, and an easy last morning. Most days have two </Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp03</Data></Cell><Cell><Data ss:Type="String">A balanced three-day Osaka trip: Day 1 covers Shinsekai and the Dotonbori neon, Day 2 the castle, Kuromon Market and a sunset view from Umeda, and Day 3 the Sumiyoshi shrine and Kaiyukan aquarium. Eve</Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp04</Data></Cell><Cell><Data ss:Type="String">A two-day Tokyo trip that covers both must-sees. Day 1 is the Ghibli Museum in Mitaka, then Meiji Jingu, ramen, and Shibuya Crossing after dark. Day 2 is Senso-ji in the morning, then Ueno Park, a Mic</Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp05</Data></Cell><Cell><Data ss:Type="String">A balanced two-day Osaka trip. Day 1 covers Osaka Castle, Shinsekai, a sunset from Umeda and Dotonbori's neon after dark. Day 2 is a quieter morning at Sumiyoshi Taisha followed by the indoor Kaiyukan</Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">jp06</Data></Cell><Cell><Data ss:Type="String">A three-day Kyoto trip that starts in the eastern hills around Kiyomizu-dera and Gion. Day two covers Arashiyama, the Golden Pavilion and Nijo Castle. The last morning is Fushimi Inari and Ginkaku-ji.</Data></Cell><Cell><Data ss:Type="String">japan: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">tp01</Data></Cell><Cell><Data ss:Type="String">Three days in New York over Christmas, with the Met on Christmas Eve because it is closed on Wednesday. Each day is grouped by area. The trip covers the classic skyline views, Central Park, the Statue</Data></Cell><Cell><Data ss:Type="String">travelplanner: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">tp02</Data></Cell><Cell><Data ss:Type="String">A four-day San Francisco trip that covers the main sights without rushing. It runs from Painted Ladies and the waterfront, through Alcatraz and the Golden Gate Bridge at golden hour, to a quiet museum</Data></Cell><Cell><Data ss:Type="String">travelplanner: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">planner</Data></Cell><Cell><Data ss:Type="String">tp03</Data></Cell><Cell><Data ss:Type="String">Two balanced days in Manhattan. Day one goes from Central Park to a vegetarian lunch in the East Village, then the High Line and a sunset view from Top of the Rock, and ends with Times Square lit up a</Data></Cell><Cell><Data ss:Type="String">travelplanner: pass/fail</Data></Cell><Cell><Data ss:Type="String">constraints/grounding</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed01</Data></Cell><Cell><Data ss:Type="String">Remove the Ghibli Museum, keep everything else.</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed02</Data></Cell><Cell><Data ss:Type="String">Move Senso-ji to day 2 in the morning, keep everything else.</Data></Cell><Cell><Data ss:Type="String">day_time</Data></Cell><Cell><Data ss:Type="String">day_time</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed03</Data></Cell><Cell><Data ss:Type="String">Change Kiyomizu-dera to 15:00, keep the rest.</Data></Cell><Cell><Data ss:Type="String">start</Data></Cell><Cell><Data ss:Type="String">start</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed04</Data></Cell><Cell><Data ss:Type="String">Remove the M+ Museum, keep everything else.</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed05</Data></Cell><Cell><Data ss:Type="String">Remove Nishiki Market, keep everything else.</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed06</Data></Cell><Cell><Data ss:Type="String">Change Kiyomizu-dera to 15:00, keep the rest.</Data></Cell><Cell><Data ss:Type="String">start</Data></Cell><Cell><Data ss:Type="String">start</Data></Cell></Row><Row><Cell><Data ss:Type="String">editor</Data></Cell><Cell><Data ss:Type="String">ed07</Data></Cell><Cell><Data ss:Type="String">Remove Ippudo Kyoto, keep everything else.</Data></Cell><Cell><Data ss:Type="String">removed</Data></Cell><Cell><Data ss:Type="Stri