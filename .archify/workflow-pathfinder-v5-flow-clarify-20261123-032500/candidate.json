  "cards": [
    {
      "dot": "emerald",
      "title": "When clarify wins",
      "items": [
        "route.need_clarification is true when the analyst says so or the intent is unclear.",
        "A plan intent with a missing destination, start date or length also clarifies before evidence work.",
        "A low-confidence modify on an existing plan becomes a clarify instead of a wrong change."
      ]
    },
    {
      "dot": "cyan",
      "title": "What the card carries",
      "items": [
        "ClarifyPayload: question, slots, labels, options, choices (label + message) and place suggestions.",
        "A fallback question is built from the missing destination/dates when the analyst gives none.",
        "The chat line stays short (“I need one detail before I can plan.”) so the card is not duplicated."
      ]
    },
    {
      "dot": "slate",
      "title": "What does not happen",
      "items": [
        "No agents run, no provider is called and no plan version is written.",
        "The assistant message is saved with meta.clarify so the next turn can reuse it.",
        "The reply ends with trace + done events, exactly like the other paths."
      ]
    }
  ]
