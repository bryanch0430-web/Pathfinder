  "cards": [
    {
      "dot": "cyan",
      "title": "Before a single model call",
      "items": [
        "deps.identity_for resolves guest token / signed-in user / local admin; one seat row blocks a second turn on the session.",
        "_produce masks PII, loads TripContext + latest plan + last 10 messages, and writes the user row before routing.",
        "A held session short-circuits to the Desk reply; a finalised trip refuses plan/modify."
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence and grounding",
      "items": [
        "Attraction, hotel, weather, flight and route work run concurrently; each failure becomes a DataGap.",
        "candidate_pool gives stable refs; the composer may only choose refs, never address/price/hour text.",
        "build_plan copies Evidence into PlanItem and settles overlaps, transfers, hotel, tickets, alternatives and budget."
      ]
    },
    {
      "dot": "violet",
      "title": "Bounded failure handling",
      "items": [
        "MAX_REPAIRS defaults to 2; the structure check reruns compose with the exact previous problems.",
        "The constraint audit is one verify JSON call; failed/unknown checks become one extra repair attempt.",
        "One composer retry on LLMError, then fallback_plan() from the sourced shortlist instead of an empty turn."
      ]
    }
  ]
