  "cards": [
    {
      "dot": "amber",
      "title": "What the edit may touch",
      "items": [
        "propose_edit asks purpose=edit for an EditDraft: move, retime, add, replace, swap_hotel, set_field, remove.",
        "A locked or confirmed item is never moved or removed; untouched items keep their data.",
        "A named place with no source triggers lookup_place(); if it still fails, the reply offers “add it anyway” as an unconfirmed stop."
      ]
    },
    {
      "dot": "violet",
      "title": "When it becomes a replan",
      "items": [
        "scope=whole or rebuild_reason returns rebuild=True and the orchestrator calls _plan_turn.",
        "A date or destination change is also a rebuild; the whole itinerary is recomposed.",
        "Every normal edit returns a proposal; only decide_proposal(accept) writes the next version."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure and handoff",
      "items": [
        "No changed item bumps the stuck counter; at 3 failed edits the chat can hand off to the Desk.",
        "One bad op is logged and skipped; the other ops still apply.",
        "diff_plans() produces the visible changed/added/removed list."
      ]
    }
  ]
