  "cards": [
    {
      "dot": "rose",
      "title": "Nothing is planned or edited",
      "items": [
        "The ask path reads the stored plan and context; it never composes or persists a plan version.",
        "The reply is streamed as token events, then _guard_output checks the canary and mask_pii runs again.",
        "The assistant row is saved with its source URLs; the stuck counter is reset."
      ]
    },
    {
      "dot": "cyan",
      "title": "Retrieval is bounded",
      "items": [
        "_search_queries uses purpose=search_query to propose short queries from the question + plan.",
        "At most 2 queries run, 4 SerpAPI results each; a failed search is simply no source.",
        "The payload carries trip brief, plan text with sources, recent turns, retrieved snippets and cost."
      ]
    },
    {
      "dot": "slate",
      "title": "What the reader sees",
      "items": [
        "Answer text streams into the same chat surface as a plan reply.",
        "Source rows travel in message metadata, not as plan items.",
        "A question about an unsourced place is answered as unknown, not filled from model memory."
      ]
    }
  ]
