# Keep the build context small and keep secrets out of the image.
.git
.gitignore
.env
.env.*
!.env.example
.claude
.archify

**/__pycache__
**/*.pyc
**/node_modules

backend/.venv
backend/tests
backend/pip-unpack-*
backend/data
backend/.tmp-chrome*

frontend/dist
frontend/storybook-static

data
docs
tmp
var
*.md
!frontend/README.md
pathfinder.bat
start.cmd
start.ps1
