# --- application ---------------------------------------------------------
ENVIRONMENT=development
# The SQLite file. It is a setting of its own, not derived from DATA_DIR. Relative paths resolve against the repository root.
# DATABASE_PATH=data/pathfinder.db

# --- writer model (OpenAI-compatible) ------------------------------------
LLM_PROVIDER=deepseek
# LLM_PROVIDER is the vendor label: "xai" reads the XAI_* block (falling back to LLM_*).
# The reference configuration in the README is xAI: set LLM_PROVIDER=xai and fill XAI_API_KEY below.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# A low-latency, general model is recommended for interactive turns.
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90

# xAI block: authoritative when LLM_PROVIDER=xai; keep it in sync with LLM_* otherwise.
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# --- web search ----------------------------------------------------------
# DeepSeek search is the default reference lookup. Use the DeepSeek account
# key (the same account as the judge), never the xAI writer key.
# Grok runs only when DeepSeek relevance is zero, and it reuses XAI_API_KEY.
WEB_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_API_KEY=
GROK_SEARCH_ENABLED=false
GROK_SEARCH_TIMEOUT_SECONDS=90

# --- System 1 router (optional; rules and the writer are fallbacks) ------
DECISION_ENABLED=true
DECISION_API_URL=https://api.typesafe.ai/v1/systemone
DECISION_API_KEY=
DECISION_MODEL=jev-latest
DECISION_AUTH_PREFIX=Bearer
DECISION_TIMEOUT_SECONDS=8

# --- judge (evaluation only) --------------------------------------------
# Optional LLM-as-a-judge. Leave JUDGE_API_KEY empty for the deterministic scorer.
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat
JUDGE_TIMEOUT_SECONDS=20

# --- observability -------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- data providers ------------------------------------------------------
GOOGLE_PLACES_API_KEY=
# Browser key for the map. Enable "Maps JavaScript API" (and Routes for legs) on
# it, and restrict it by HTTP referrer before exposing the app publicly.
GOOGLE_MAPS_API_KEY=
# AMap (Gaode) Web Service key: the maps fallback for mainland China when Google is
# unconfigured, failing or empty. Server-side only; leave unset to disable it.
# AMAP_KEY=
SERPAPI_KEY=
YOUTUBE_API_KEY=

ENABLE_NOTES=true
ENABLE_FLIGHTS=true
ENABLE_ROUTES=true
ENABLE_BILIBILI=true
ENABLE_YOUTUBE=true
ENABLE_ROUTE_MATRIX=true
ENABLE_TIMEZONE=true
ENABLE_ELEVATION=true

# --- policy --------------------------------------------------------------
ROUTER_THRESHOLD=0.8
MAX_REPAIRS=2
PREPLAN_BUDGET_SECONDS=90
AGENT_TIMEOUT_SECONDS=30
MEMORY_SIMILARITY_CUTOFF=0.72
SEARCH_WINDOW_MONTHS=24
DEFAULT_CURRENCY=HKD

# --- application secrets -------------------------------------------------
ADMIN_TOKEN=REPLACE_ME
# Signs the HS256 bearer tokens. Outside ENVIRONMENT=development/test the app
# refuses to start unless AUTH_SECRET is a random value of at least 32 characters
# and ADMIN_TOKEN is a real secret (not local-admin / REPLACE_ME).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_ME
CANARY_TOKEN=<<CANARY-PATHFINDER-7f3a9c>>

# Wikimedia requires a descriptive User-Agent with contact information and a
# framework name. Keep this current; a generic UA is refused with HTTP 403.
WIKIMEDIA_USER_AGENT=Pathfinder/1.0 (https://github.com/bryanch0430-web/Pathfinder; educational project) python-httpx/0.28

# --- sharing, rate limits and streaming ----------------------------------
# A public share link stops working this many days after it is created.
# SHARE_TTL_DAYS=30
# Requests per client IP per minute, counted in memory per process; 0 turns a limit off.
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_AI_PER_MINUTE=30
# RATE_LIMIT_CREATE_PER_MINUTE=60
# RATE_LIMIT_LOOKUP_PER_MINUTE=60
# RATE_LIMIT_HANDBOOK_PER_MINUTE=60
# The chat stream sends a keepalive after this many quiet seconds and ends a turn after the deadline.
# The deadline counts the turn's own work, not the wait for an earlier message on the same trip.
# SSE_KEEPALIVE_SECONDS=15
# TURN_DEADLINE_SECONDS=180

# --- other settings: the defaults, commented out ------------------------------
# Uncomment a line to change that setting.
# Name the API reports at /api/runtime.
# APP_NAME=Pathfinder
# Not read by the application yet.
# DEBUG=false
# The data folder, created at start. It does not move the database, the traces or the evaluation output: DATABASE_PATH, TRACE_DIR and EVAL_DIR are settings of their own, each with a default path under data/, so set them too to keep those files elsewhere. Relative paths resolve against the repository root.
# DATA_DIR=data
# One JSON trace per request, read through /api/admin/spans/{request_id}.
# TRACE_DIR=data/traces
# Where evaluation runs write their output.
# EVAL_DIR=data/eval
# The built frontend (npm run build) that the backend serves at /.
# FRONTEND_DIST=frontend/dist
# Browser origins allowed to call the API, comma separated.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# How long a sign-in lasts.
# AUTH_TOKEN_HOURS=168
# Sent to data sources that accept a generic client string.
# USER_AGENT=Pathfinder/1.0 (COMP7608B student project)
# Only reported at /api/runtime, and the language a new empty trip form starts with. A message is handled in the language of its own request and a plan is shown in the display language the traveller chose, whatever this says.
# DEFAULT_LOCALE=en
# Only listed at /api/runtime, comma separated; it does not limit what the API accepts. A plan can be shown in English and Traditional Chinese (en, zh-Hant), which is fixed in the code.
# SUPPORTED_LOCALES=en,zh-Hans,zh-Hant
# Ask the writer for JSON output; turn off for an endpoint that rejects response_format.
# LLM_JSON_MODE=true
# Not read by the application yet.
# DECISION_PROVIDER=typesafe
# Path added to DECISION_API_URL unless the URL already ends with it.
# DECISION_PATH=/v1/systemone
# Base URL of a Places API proxy. Empty means places.googleapis.com.
# GOOGLE_PLACES_PROXY=
# Hong Kong trips check Observatory warnings and MTR line status.
# ENABLE_HK_DISRUPTIONS=true
# Let the rules decide an unambiguous message without a router or writer call.
# ROUTER_RULES_FIRST=true
# Timeout of one request to a data source.
# HTTP_TIMEOUT_SECONDS=15
# Retries of a request to the main data sources: flights, hotels, routes, places, the forecast, geocoding and web search. Elevation, time zones, videos, Hong Kong feeds, archive weather and exchange rates keep a fixed count of their own.
# HTTP_RETRIES=2
# Lookups one tool path (plan, edit, question, or the refresh of an outdated plan) may make before the rest are refused with a data gap. An edit of an outdated plan refreshes it first, so one request can make up to twice this many. 0 turns the cap off.
# MAX_TOOL_CALLS_PER_TURN=150
# The longest trip the planner accepts.
# MAX_DAYS=14
# The most attractions placed on one day.
# MAX_ATTRACTIONS_PER_DAY=4
# The least a budget should allow per traveller per night, in US dollars (converted to the trip's currency). A new trip below it, or with a budget of 0, is asked about before planning. 0 turns the check off.
# MIN_BUDGET_PER_PERSON_NIGHT=150
# How long a forecast counts as current before it is fetched again (6 hours).
# WEATHER_FRESH_SECONDS=21600
# How long a fare counts as current (24 hours).
# TICKET_FRESH_SECONDS=86400
# How long a hotel price counts as current (7 days).
# HOTEL_FRESH_SECONDS=604800
# How long attraction data counts as current (30 days).
# ATTRACTION_FRESH_SECONDS=2592000
# Screen traveller messages for prompt injection before any model sees them.
# BLOCKLIST_ENABLED=true
# Not read by the application yet.
# FENCE_ENABLED=true

# --- other settings: the defaults, commented out ------------------------------
# Uncomment a line to change that setting.
# ENABLE_PREPLAN_AUDIT=false
# AUDIT_TIMEOUT_SECONDS=20
# AUDIT_FOLLOW_UP_SECONDS=15
# AUDIT_MAX_FOLLOW_UPS=3
# AUDIT_MAX_ITEMS_PER_AGENT=26
