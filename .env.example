# --- application ---------------------------------------------------------
ENVIRONMENT=development
# Relative paths resolve against the Pathfinder_v1 directory.
# DATABASE_PATH=data/pathfinder.db

# --- writer model (OpenAI-compatible) ------------------------------------
LLM_PROVIDER=xai
# LLM_PROVIDER is the vendor label: "xai" reads the XAI_* block (falling back to LLM_*).
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
# A low-latency, general model is recommended for interactive turns.
LLM_MODEL=grok-4.20-0309-non-reasoning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# xAI block: authoritative when LLM_PROVIDER=xai; keep it in sync with LLM_* otherwise.
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# --- System 1 router (optional; rules and the writer are fallbacks) ------
DECISION_ENABLED=true
DECISION_API_URL=https://api.typesafe.ai/v1/systemone
DECISION_API_KEY=
DECISION_MODEL=jev-latest
DECISION_AUTH_PREFIX=Bearer

# --- judge (evaluation only) --------------------------------------------

# --- observability -------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- data providers ------------------------------------------------------
GOOGLE_PLACES_API_KEY=
# Browser key for the map. Enable "Maps JavaScript API" (and Routes for legs) on
# it, and restrict it by HTTP referrer before exposing the app publicly.
GOOGLE_MAPS_API_KEY=
SERPAPI_KEY=
YOUTUBE_API_KEY=
# Mainland-China map key. The AK must have the 浏览器端 (JavaScript API) service
# enabled and this origin whitelisted; a server-only AK answers "APP服务被禁用了"
# and the console falls back to Google Maps with a visible notice.

ENABLE_NOTES=true
ENABLE_FLIGHTS=true
ENABLE_ROUTES=true
ENABLE_BILIBILI=true
ENABLE_YOUTUBE=true

# --- policy --------------------------------------------------------------
ROUTER_THRESHOLD=0.8
MAX_REPAIRS=2
PREPLAN_BUDGET_SECONDS=90
AGENT_TIMEOUT_SECONDS=30
MEMORY_SIMILARITY_CUTOFF=0.72
SEARCH_WINDOW_MONTHS=24
DEFAULT_CURRENCY=HKD

# --- application secrets -------------------------------------------------
ADMIN_TOKEN=REPLACE_ME
CANARY_TOKEN=<<CANARY-PF30-7f3a9c>>

# Wikimedia requires a descriptive User-Agent with contact information and a
# framework name. Keep this current; a generic UA is refused with HTTP 403.
WIKIMEDIA_USER_AGENT=Pathfinder30/1.0 (https://github.com/bryan0430-web/Pathfinder; educational project) python-httpx/0.28
ENABLE_ROUTE_MATRIX=true
ENABLE_TIMEZONE=true
ENABLE_ELEVATION=true

# --- judge (evaluation only) --------------------------------------------
# Optional LLM-as-a-judge. Leave JUDGE_API_KEY empty for the deterministic scorer.
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat
JUDGE_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=60
DECISION_TIMEOUT_SECONDS=1.5
