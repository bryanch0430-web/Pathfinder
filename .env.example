# Copy to .env (repo root) and adjust. Every key maps to backend/settings.py (prefix PATHFINDER_).
# Defaults shown are the code defaults unless noted.

# ---- Storage (team decision: PostgreSQL + pgvector) --------------------------------------------
# "memory" runs without a database (tests use it); "postgres" uses DATABASE_URL below.
PATHFINDER_STORAGE_BACKEND=postgres
PATHFINDER_DATABASE_URL=postgresql+asyncpg://pathfinder:pathfinder@localhost:5432/pathfinder
PATHFINDER_EMBEDDING_DIM=1536

# ---- Thresholds from the proposal -----------------------------------------------------------------
PATHFINDER_ROUTER_CONFIDENCE_THRESHOLD=0.8
PATHFINDER_MAX_MODEL_REPAIRS=2
PATHFINDER_PREPLANNING_TIME_BUDGET_S=20
PATHFINDER_SIMILARITY_CUTOFF=0.75
PATHFINDER_RETRIEVAL_TOP_K=3
PATHFINDER_HISTORY_WINDOW=10

# ---- Tool retry policy ------------------------------------------------------------------------------
PATHFINDER_TOOL_MAX_ATTEMPTS=3
PATHFINDER_TOOL_BACKOFF_BASE_S=0.2
PATHFINDER_TOOL_BACKOFF_MAX_S=2.0
PATHFINDER_TOOL_CALL_TIMEOUT_S=4.0
PATHFINDER_TOOL_RETRY_BUDGET_S=8.0

# ---- Staleness limits (seconds) --------------------------------------------------------------------
PATHFINDER_STALE_AFTER_WEATHER_S=21600
PATHFINDER_STALE_AFTER_TICKET_S=3600
PATHFINDER_STALE_AFTER_HOTEL_S=86400
PATHFINDER_STALE_AFTER_ATTRACTION_S=604800

# ---- Security ----------------------------------------------------------------------------------------
# Empty -> a random canary is generated per process.
PATHFINDER_CANARY_TOKEN=

# ---- Models (ALL PROVISIONAL; only "mock" is implemented) --------------------------------------
PATHFINDER_ROUTER_PROVIDER=mock          # TODO(provisional): jev
PATHFINDER_ROUTER_MODEL=jev
PATHFINDER_AGENT_LLM_PROVIDER=mock       # TODO(provisional): xai (Grok 4.7)
PATHFINDER_AGENT_MODEL=grok-4.7
PATHFINDER_JUDGE_PROVIDER=mock           # TODO(provisional): openai (e.g. GPT-4)
PATHFINDER_JUDGE_MODEL=gpt-4
PATHFINDER_EMBEDDING_PROVIDER=mock       # TODO(provisional): openai (text-embedding-3-large)
PATHFINDER_EMBEDDING_MODEL=text-embedding-3-large
PATHFINDER_RERANKER_PROVIDER=mock        # TODO(provisional): jev
PATHFINDER_XAI_API_KEY=
PATHFINDER_OPENAI_API_KEY=
PATHFINDER_JEV_API_KEY=

# ---- Tool providers (ALL PROVISIONAL; only "mock" is implemented) ------------------------------
PATHFINDER_SEARCH_PROVIDER=mock
PATHFINDER_MAPS_PROVIDERS=["mock"]       # ordered fallback chain, e.g. ["google","amap"]
PATHFINDER_WEATHER_PROVIDER=mock
PATHFINDER_PLACES_PROVIDER=mock
PATHFINDER_TICKET_PROVIDER=mock
PATHFINDER_GOOGLE_MAPS_API_KEY=
PATHFINDER_AMAP_API_KEY=

# ---- Observability -------------------------------------------------------------------------------------
# Langfuse is enabled when both keys are set.
PATHFINDER_LANGFUSE_PUBLIC_KEY=
PATHFINDER_LANGFUSE_SECRET_KEY=
PATHFINDER_LANGFUSE_HOST=https://cloud.langfuse.com
PATHFINDER_LOG_DIR=var/logs
PATHFINDER_CALL_LOG_JSONL=true

# ---- API -------------------------------------------------------------------------------------------------
PATHFINDER_CORS_ORIGINS=["http://localhost:5173"]

# ---- Tests (optional): run the postgres-marked tests against a pgvector database -------------------
# PATHFINDER_TEST_DATABASE_URL=postgresql+asyncpg://pathfinder:pathfinder@localhost:5432/pathfinder_test
