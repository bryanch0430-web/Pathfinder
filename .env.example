# Pathfinder v5 — example environment.
#
# Copy this file to `.env` and fill in the keys you have. With no keys the app
# still starts, but model calls and live evidence will report unavailable.
#
# Provider rules:
#   LLM_PROVIDER=openai / openai-compatible  -> OPENAI_* (then LLM_*, then POE_*)
#   LLM_PROVIDER=xai                         -> XAI_*
#   anything else                           -> LLM_* / POE_*
#
# The writer and the constraint verifier are deliberately separate providers.

# --- application ---------------------------------------------------------
ENVIRONMENT=development
DATABASE_PATH=data/pathfinder.db
DEFAULT_CURRENCY=HKD
TURN_DEADLINE_SECONDS=300
SSE_KEEPALIVE_SECONDS=15

# --- writer model --------------------------------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.poe.com/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1

# --- constraint verifier (its own provider) -----------------------------
# Defaults: DeepSeek Flash, temperature 0, 1,500-token cap.
# If VERIFIER_API_KEY is blank, the verifier falls back to the writer model.
VERIFIER_BASE_URL=https://api.deepseek.com/v1
VERIFIER_API_KEY=
VERIFIER_MODEL=deepseek-flash
VERIFIER_TEMPERATURE=0
VERIFIER_MAX_TOKENS=1500
VERIFIER_TIMEOUT_SECONDS=60

# --- web search ----------------------------------------------------------
# The model writes queries; code executes them in this order:
#   1. SerpAPI Google
#   2. Wikipedia
#   3. DeepSeek Search (final fallback)
#
# DeepSeek here is a search API, not an LLM browsing call.
WEB_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_API_KEY=
# Optional: reuse the verifier key for search when both belong to the same
# DeepSeek account. Set this explicitly rather than relying on shell syntax.
# DEEPSEEK_SEARCH_API_KEY=your-deepseek-search-key

# --- optional System 1 router (Jev) -------------------------------------
DECISION_ENABLED=false
DECISION_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_API_KEY is accepted as an alias for DECISION_API_KEY (test harness).
DECISION_API_KEY=
JEV_API_KEY=
DECISION_MODEL=jev-latest
DECISION_AUTH_PREFIX=Bearer
DECISION_TIMEOUT_SECONDS=1.5

# --- judge model (reserved) ---------------------------------------------
# Not called by the v5 runtime or evaluator. Kept for future evaluation use.
# JUDGE_BASE_URL=https://api.deepseek.com
# JUDGE_API_KEY=
# JUDGE_MODEL=deepseek-chat
# JUDGE_TIMEOUT_SECONDS=20

# --- data providers ------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_KEY=
SERPAPI_KEY_POOL=
YOUTUBE_API_KEY=

ENABLE_NOTES=true
ENABLE_FLIGHTS=true
ENABLE_ROUTES=true
ENABLE_BILIBILI=false
ENABLE_YOUTUBE=true
ENABLE_ROUTE_MATRIX=true
ENABLE_TIMEZONE=true
ENABLE_ELEVATION=false

# --- policy --------------------------------------------------------------
# These are two different signals and must be tuned separately.
ANALYST_CONFIDENCE_THRESHOLD=0.8
JEV_CONFIDENCE_THRESHOLD=0.8
MAX_REPAIRS=2
PREPLAN_BUDGET_SECONDS=90
AGENT_TIMEOUT_SECONDS=30
MEMORY_SIMILARITY_CUTOFF=0.72
SEARCH_WINDOW_MONTHS=24
REVIEWER_REASONING=low
REVIEWER_TIMEOUT_SECONDS=25

# --- application secrets -------------------------------------------------
# For a demo these defaults are fine on loopback. Before exposing the app,
# change both: ADMIN_TOKEN protects every operator route, and SECRET_KEY signs
# sign-in tokens (a known value lets anyone forge one).
ADMIN_TOKEN=local-admin
LOCAL_ADMIN=true
SECRET_KEY=change-me
CANARY_TOKEN=<<CANARY-change-me>>
LOCAL_ADMIN_PROXY=
# Browser origins allowed to call the API, comma separated. The app's own
# origin and the Vite dev server are the defaults; a same-origin page needs no
# entry. Another site is never allowed to read operator routes.
CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100,http://127.0.0.1:5173,http://localhost:5173
WIKIMEDIA_USER_AGENT=Pathfinder50/1.0 (educational project) python-httpx

# --- observability (optional) -------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- offline mode --------------------------------------------------------
# 1 = no live provider calls; use the curated place corpus.
PATHFINDER_SANDBOX=0
