# Pathfinder v5 — example environment.
#
# Copy to `.env` and fill the keys you have. With no keys at all the app still
# starts in sandbox mode; with a writer key it plans for real.
#
#   LLM_PROVIDER=openai     -> the OPENAI_* block is used (Poe is the default host)
#   LLM_PROVIDER=xai        -> the XAI_* block is used
#   anything else           -> the LLM_* block is used

ENVIRONMENT=development
DATABASE_PATH=data/pathfinder.db
DEFAULT_CURRENCY=HKD
TURN_DEADLINE_SECONDS=240
SSE_KEEPALIVE_SECONDS=15

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.poe.com/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90

OPENAI_BASE_URL=https://api.poe.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=claude-sonnet-5.5

XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

WEB_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_API_KEY=

DECISION_ENABLED=false
DECISION_API_URL=https://api.typesafe.ai/v1/systemone
DECISION_API_KEY=
DECISION_MODEL=jev-latest

JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat

LANGFUSE_ENABLED=false

GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_KEY=
SERPAPI_KEY_POOL=
YOUTUBE_API_KEY=

ENABLE_NOTES=true
ENABLE_FLIGHTS=true
ENABLE_ROUTES=true
ENABLE_BILIBILI=false
ENABLE_YOUTUBE=true

ROUTER_THRESHOLD=0.8
MAX_REPAIRS=2
PREPLAN_BUDGET_SECONDS=90
AGENT_TIMEOUT_SECONDS=30
SEARCH_WINDOW_MONTHS=24

ADMIN_TOKEN=local-admin
LOCAL_ADMIN=true
SECRET_KEY=change-me
LOCAL_ADMIN_PROXY=
CANARY_TOKEN=<<CANARY-change-me>>
WIKIMEDIA_USER_AGENT=Pathfinder50/1.0 (educational project) python-httpx/0.28

PATHFINDER_SANDBOX=0
